# 'make' Makefile
#

#INCLUDES=-I/usr/include -I/usr/include/c86
#DEFINES=
#CPPFLAGS=-0 $(INCLUDES) $(DEFINES)
#CPP=$(BIN)cpp

##### Standardized section of Makefile #####

CC=$(BIN)c88
C2=$(BIN)gen88
AS=$(BIN)asm88
AR=$(BIN)lib88
LD=$(BIN)link88

CFLAGS = $(CLBASE) $(WARNINGS) $(LOCALFLAGS)

# Automated rules for C88 toolchain
.c.o:
	#$(CPP) $(CPPFLAGS) $*.c -o $*.i
	$(CC) $*.c PW $(CFLAGS)
	$(C2) $* Z
	#$(AS) $*.as L

.s.o:
	$(AS) $*.s L

##### End of standardized section #####

PROG=make
LOCALFLAGS = -Dunix
LIBC = ../libc/cstdio.a
OBJS = check.o input.o macro.o main.o make.o reader.o rules.o

all: $(OBJS) $(PROG)

$(PROG): $(OBJS)
	$(LD) $^ $(LIBC) -O$(PROG) -P$(PROG).lst -_ -S4000
	cp $(PROG) /root/bin2

clean:
	rm -f *.i *.as *.o *.a *.lst $(PROG)
